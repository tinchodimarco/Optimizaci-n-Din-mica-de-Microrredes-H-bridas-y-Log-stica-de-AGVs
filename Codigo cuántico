from qiskit import QuantumCircuit
from qiskit_ionq import IonQProvider
import os

def create_qaoa_agv_circuit():
    """
    Crea el circuito QAOA para el ruteo de AGVs de forma nativa,
    evitando el uso del módulo obsoleto qiskit.opflow.
    """
    # 2 cúbits para representar las elecciones de ruta de los 2 AGVs
    num_qubits = 2
    qc = QuantumCircuit(num_qubits, num_qubits)
    
    # 1. Preparación del estado inicial (Superposición equitativa)
    qc.h(range(num_qubits))
    
    # Parámetros simulados de optimización (gamma y beta)
    gamma = 0.5
    beta = 0.3
    coeff_zz = 2.0  # Penalización por congestión
    coeff_zi = 1.0  # Costo base AGV 0
    coeff_iz = 0.5  # Costo base AGV 1
    
    # 2. Mezclador de Costos (Cost Unitary / Simulación del Hamiltoniano)
    # Término ZZ (Interacción / Conflicto de tráfico entre ambos AGVs)
    qc.cx(0, 1)
    qc.rz(2 * gamma * coeff_zz, 1)
    qc.cx(0, 1)
    
    # Términos individuales (Z en cada cúbit)
    qc.rz(2 * gamma * coeff_zi, 0)
    qc.rz(2 * gamma * coeff_iz, 1)
    
    # 3. Mezclador de Transición (Mixer Unitary - Rotaciones X)
    for i in range(num_qubits):
        qc.rx(2 * beta, i)
        
    # 4. Medición final
    qc.measure(range(num_qubits), range(num_qubits))
    
    return qc

# Generar el circuito
qc_agv = create_qaoa_agv_circuit()

# Configuración del Backend de IonQ Aria 1
API_KEY = os.getenv("IONQ_API_KEY", "TU_API_KEY_DE_QOLLAB_O_IONQ")
provider = IonQProvider(token=API_KEY)
backend = provider.get_backend("ionq_simulator") # O el backend QPU asignado en Qollab

# Ejecución en el motor de Aria 1
shots = 1024
print("Enviando circuito AGV optimizado a Aria 1...")
job = backend.run(qc_agv, shots=shots)
result = job.result()
counts = result.get_counts(qc_agv)

print("\nResultados (AGV Ruteo):", counts)
